# ==============================================================================
# SewDesk — Environment Variables Configuration
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit real keys or .env files to Git.
# - Vite variables prefixed with VITE_ are public and bundled into frontend code.
# - Service role keys, payment secrets, and email API keys must stay strictly server-side.

# Public Supabase Client (safe for frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-side (Used in Edge Functions / backend migrations only)
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway: Paystack (Secret key stays in Edge Functions)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Payment Gateway: Hubtel (Credentials stay in Edge Functions)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# Transactional Email: Resend
RESEND_API_KEY=

# Application URL
APP_URL=http://localhost:5173
